# Copy to .env and fill in the token for your solver; the Makefile loads
# .env automatically (.env is gitignored).

# Claude Code solver (scripts/claude_code.sh): one of the two.
# Generate an OAuth token with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
#ANTHROPIC_API_KEY=

# GitHub Copilot solver (scripts/copilot.sh): fine-grained PAT with the
# Copilot Requests permission, or a Copilot OAuth token. Classic ghp_
# PATs are rejected.
#COPILOT_GITHUB_TOKEN=

# Other agent CLIs in the image.
#GEMINI_API_KEY=
#OPENAI_API_KEY=

# Optional overrides; see scripts/claude_code.sh and scripts/copilot.sh.
#CLAUDE_MODEL=claude-opus-5
#COPILOT_MODEL=claude-opus-5
