# Teach GitHub Linguist what this repository is written in.
#
# Every task directory is generated by template/gen.py, which copies the
# same build infrastructure into each of the 103 tasks. Those copies are
# not source: 103 identical check.sh files outweighed everything else and
# made the repository look like a shell project. Marking them generated
# excludes them from the language stats (and collapses them in diffs);
# the originals under template/ and scripts/ still count.

tasks/*/check.sh            linguist-generated
tasks/*/lakefile.lean       linguist-generated
tasks/*/lake-manifest.json  linguist-generated
tasks/*/lean-toolchain      linguist-generated

solved/*/check.sh           linguist-generated
solved/*/lakefile.lean      linguist-generated
solved/*/lakefile.toml      linguist-generated
solved/*/lake-manifest.json linguist-generated
solved/*/lean-toolchain     linguist-generated

# Raw agent transcripts kept as evidence for the published solutions.
solved/*/logs/**            linguist-generated
